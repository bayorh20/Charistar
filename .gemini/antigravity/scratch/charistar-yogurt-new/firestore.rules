rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is the user the owner of the document?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Is the user an administrator?
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Products: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Product Reviews: Anyone can read, authenticated users can write reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }
    }

    // Users Profiles: Secure read and write permissions
    match /users/{userId} {
      // Only the owner or an admin can read individual user profiles
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow signup with default role 'user' and initial wallet balance limits
      allow create: if isAuthenticated() 
        && (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role == 'user')
        && (!request.resource.data.keys().hasAll(['walletBalance']) || request.resource.data.walletBalance <= 10000);
        
      // Prevent privilege escalation: Users can edit details but CANNOT modify their own 'role' field.
      allow update: if isAdmin() || (
        isOwner(userId) 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      
      // Transactions subcollection
      match /transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Favorites subcollection
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Orders Collection: Supports both authenticated users and guest checkouts
    match /orders/{orderId} {
      allow get: if true; // Allows order details tracking page lookup by ID (both guests and registered users)
      
      // Only administrators or the order owner can list orders
      allow list: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      
      // Support creation for both registered users and guests
      allow create: if (request.resource.data.userId == 'guest') || (
        isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && (!request.resource.data.keys().hasAll(['priceValidated']) || request.resource.data.priceValidated == false)
      );
        
      // Only administrators can update order details client-side
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Guests Collection: Captures guest details for order routing & marketing leads
    match /guests/{guestId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Slides Collection: Anyone can read, admins can modify
    match /slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage Sections Collection: Anyone can read, admins can modify
    match /homepage_sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}