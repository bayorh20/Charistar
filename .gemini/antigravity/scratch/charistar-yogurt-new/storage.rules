rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is the user an admin?
    function isAdmin() {
      return isAuthenticated() && 
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Is the user the owner of the path?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Product images: Anyone can view, only admins can upload/delete
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User uploads (e.g. avatars): Owner can read/write, admin can read
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }
    
    // Public assets: Anyone can read, only admin can write
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
