{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "orderfoodmaxx",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        { "source": "/index.html",          "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
        { "source": "/sw.js",               "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
        { "source": "/manifest.webmanifest","headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
        { "source": "**/*.@(js|css)",       "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
