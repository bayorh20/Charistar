rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read: menu, categories, settings ──────────────────────────────
    // These must be readable without auth so the customer app can load the menu
    // even before the user logs in (guest browsing).
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /option_presets/{presetId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Orders: guests and registered users can create/read/update ───────────
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // ── Users: only the user themselves + authenticated sessions ─────────────
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── Admins: authenticated session check for login verification ──────────
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    // ── Riders, Reviews, Coupons, Affiliates: authenticated only ─────────────
    match /riders/{riderId} {
      allow read, write: if request.auth != null;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /affiliates/{affiliateId} {
      allow read, write: if request.auth != null;
    }

    // ── Support chat: guests and registered users ────────────────────────────
    match /support_chats/{chatId} {
      allow read, write: if true;
    }

    // ── Audit logs: write from any authenticated session, read admin only ────
    match /audit_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // ── Marketing: read public, write authenticated ───────────────────────────
    match /marketing/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
